# Nothing here is a secret: the page is static files and holds no settings.
# These only place the container next to your reverse proxy.

# The container's name, which is also the hostname your reverse proxy uses.
# Point the proxy at CONTAINER_NAME:8080 over plain http.
CONTAINER_NAME=notfallkarte

# The Docker network shared with your reverse proxy. Create it once with
#   docker network create proxy-network
# (or name the one the proxy already uses), and attach the proxy's container to
# it. If revoked runs on the same host, use the same network as its stack.
PROXY_NETWORK=proxy-network

# The tag `docker compose build` gives the image, e.g. a registry path if you
# push it: ghcr.io/<you>/notfallkarte:latest
IMAGE=notfallkarte:latest

# Only with the `ports:` lines in docker-compose.yml uncommented (no reverse
# proxy on this host): the host port the page is served on.
HTTP_PORT=8080
