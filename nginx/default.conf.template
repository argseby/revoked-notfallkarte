# Static files only: the page talks to no server, not even this one's API.
server {
    listen 8080;
    listen [::]:8080;
    server_name _;
    root /usr/share/nginx/html;

    # add_header in a location replaces the server's set, so every location
    # includes the same file.
    include /etc/nginx/conf.d/security_headers.inc;

    location /assets/ {
        include /etc/nginx/conf.d/security_headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location / {
        include /etc/nginx/conf.d/security_headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
